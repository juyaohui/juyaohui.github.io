{
  "name": "jade-homepage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Jade 的个人主页 / 博客 / 笔记，VitePress + TypeScript + pnpm，内置局域网手机同步服务。",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @blog/web dev",
    "build": "pnpm --filter @blog/web build",
    "preview": "pnpm --filter @blog/web preview",
    "sync": "pnpm --filter @blog/relay start",
    "sync:dev": "pnpm --filter @blog/relay dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "migrate": "node scripts/migrate-content.mjs",
    "deploy": "node scripts/deploy-gh.mjs",
    "shot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "playwright-core": "^1.55.0"
  }
}
